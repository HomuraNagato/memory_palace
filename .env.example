# Host directories mounted read-only into the Memory Palace container.
MEMORY_PALACE_OBSIDIAN_PATH=/path/to/notes
MEMORY_PALACE_LIBRARY_PATH=/path/to/library

# A stable key selects this operator's watch roots and database namespace.
# Separate users with semicolons; separate roots for one user with commas.
MEMORY_PALACE_WATCH_DIRS=user-a=/home/src/data/obsidian|scope=memories|collection=obsidian,/home/src/data/library|scope=library|collection=library

# PostgreSQL must include the vector and pg_trgm extensions. Memory Palace
# creates its own tables and indexes during startup.
MEMORY_PALACE_DATABASE_URL=host=127.0.0.1 port=5438 dbname=pensieve user=postgres password=change-me sslmode=disable
MEMORY_PALACE_HTTP_ADDR=:8013

# These services are normally started by Beemo before Memory Palace.
MEMORY_PALACE_EMBEDDING_URL=http://127.0.0.1:5021/v1/embeddings
MEMORY_PALACE_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
MEMORY_PALACE_EMBEDDING_API_KEY=
MEMORY_PALACE_CONTEXTUALIZER_URL=http://127.0.0.1:5014/v1/chat/completions
MEMORY_PALACE_CONTEXTUALIZER_MODEL=auto
MEMORY_PALACE_CONTEXTUALIZER_BATCH_SIZE=4
MEMORY_PALACE_QUERY_REWRITER_URL=http://127.0.0.1:5014/v1/chat/completions
MEMORY_PALACE_QUERY_REWRITER_MODEL=auto
MEMORY_PALACE_QUERY_REWRITER_TIMEOUT_MS=4000
MEMORY_PALACE_RERANKER_URL=http://127.0.0.1:5022

# Optional external-provider credentials.
OPENAI_API_KEY=
LLAMA_CLOUD_API_KEY=
